---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutNav from '@/components/AboutNav.astro';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import { cases } from '@/data/about';
import { industries } from '@/data/home';

const sectors = [
  { title: '政务', description: '跨部门、跨层级的安全接入与数据共享。' },
  { title: '金融', description: '面向多业务系统的统一认证与准入控制。' },
  { title: '能源与电力', description: '多形态终端与工业场景的密码接入。' },
  { title: '交通', description: '设备、人员与业务系统的可信接入。' },
  { title: '工业与物联网', description: '软密码模块适配多形态物联网终端。' },
  { title: '应急与环保', description: '复杂网络环境下的身份与访问安全。' },
] as const;
---

<BaseLayout
  title="行业案例"
  description="联易软件在政务、金融、能源、交通、工业、物联网等行业的接入安全实践与公开报道案例。"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '行业案例',
    description: '联易软件在政务、金融、能源、交通、工业、物联网等行业的接入安全实践。',
    url: 'https://www.emaplink.com.cn/about/cases/',
  }}
>
  <PageHero
    eyebrow="关于我们"
    title="行业案例"
    description="从食品安全追溯到药品监管，从终端准入到数据交互，把接入安全落在真实业务场景里。"
    breadcrumbs={[{ label: '首页', href: '/' }, { label: '关于我们', href: '/about/' }, { label: '行业案例' }]}
    compact
  />

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[14rem_1fr] lg:gap-16">
      <AboutNav />

      <div>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">落地实践</p>
            <h2 class="mt-3 text-2xl font-semibold text-ink-900 sm:text-3xl">从公开报道看场景落地</h2>
          </div>
          <p class="max-w-md text-xs leading-5 text-muted">
            以下案例依据站内已有公开报道整理，用于说明业务场景与安全需求，不构成客户背书。
          </p>
        </div>

        <div class="mt-8 space-y-4">
          {
            cases.map((item, index) => (
              <article class="group card relative overflow-hidden p-6 transition duration-300 hover:border-brand-500/40 hover:shadow-card sm:p-7">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-full bg-brand-100 px-2.5 py-1 text-[0.6875rem] font-semibold text-brand-700">
                    {item.sector}
                  </span>
                  <span class="font-mono text-[0.6875rem] tracking-wider text-muted">
                    0{index + 1}
                  </span>
                </div>
                <h3 class="mt-4 text-xl font-semibold text-ink-900 transition group-hover:text-brand-600">
                  {item.title}
                </h3>
                <p class="mt-3 max-w-3xl text-sm leading-7 text-muted">{item.summary}</p>
                <p class="mt-5 text-xs text-muted">{item.source}</p>
              </article>
            ))
          }
        </div>

        <div class="mt-14">
          <p class="eyebrow">行业覆盖</p>
          <h2 class="mt-3 text-2xl font-semibold text-ink-900 sm:text-3xl">面向复杂行业的接入安全能力</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {
              sectors.map((sector) => (
                <div class="rounded-2xl border border-line bg-white p-5">
                  <div class="flex items-center gap-2.5">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-ink-950 text-cyan-400">
                      <Icon name="shield" size={15} />
                    </span>
                    <h3 class="text-sm font-semibold text-ink-900">{sector.title}</h3>
                  </div>
                  <p class="mt-3 text-sm leading-6 text-muted">{sector.description}</p>
                </div>
              ))
            }
          </div>

          <div class="mt-8 flex flex-wrap gap-2">
            {industries.map((industry) => (
              <span class="rounded-full border border-line bg-white px-3.5 py-1.5 text-sm text-ink-900/65">
                {industry}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

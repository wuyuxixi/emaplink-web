---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import SolutionCard from "@/components/SolutionCard.astro";
import PageHero from "@/components/ui/PageHero.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Icon from "@/components/ui/Icon.astro";
import { solutions, type Solution } from "@/data/solutions";
import { site } from "@/data/site";

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const pillars = solution.pillars ?? [];
const related = solutions
  .filter((item) => item.slug !== solution.slug)
  .slice(0, 2);
const pageUrl = new URL(`/solutions/${solution.slug}/`, site.url).href;
const valueIcons = ["settings", "shield", "layers"] as const;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: `${site.url}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: "解决方案",
      item: `${site.url}/#solutions`,
    },
    { "@type": "ListItem", position: 3, name: solution.name, item: pageUrl },
  ],
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: solution.name,
  description: solution.metaDescription,
  provider: { "@type": "Organization", name: site.legalName, url: site.url },
  areaServed: "CN",
  url: pageUrl,
};
---

<BaseLayout
  title={solution.name}
  description={solution.metaDescription}
  jsonLd={[breadcrumbJsonLd, serviceJsonLd]}
>
  <PageHero
    eyebrow="解决方案"
    title={solution.name}
    description={solution.tagline}
    breadcrumbs={[
      { label: "首页", href: "/" },
      { label: "解决方案", href: "/#solutions" },
      { label: solution.name },
    ]}
    asideItems={solution.values.map((value) => value.title)}
    asideLabel="方案价值"
  />

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
      <div>
        <p class="eyebrow">市场需求</p>
        <h2 class="section-title mt-4">把安全问题前置到接入与交互环节</h2>
        <div class="mt-6 rounded-2xl border border-line bg-white p-5">
          <p class="text-xs font-semibold tracking-[0.14em] text-muted">
            适用行业
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {solution.scenarioTags.slice(0, 6).map((tag) => (
              <span class="rounded-full bg-paper px-3 py-1 text-xs text-ink-900/65">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="space-y-5 text-base leading-8 text-muted">
        {solution.market.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <figure class="detail-figure">
          <div>
            <img
              src={solution.heroImage}
              alt={solution.heroAlt}
              width="1000"
              height="560"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>{solution.name} · 接入安全场景示意</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden tonal-panel py-20">
    <div class="container-page relative">
      <SectionHeading
        tone="dark"
        eyebrow="方案思路"
        title="以密码为信任起点，覆盖接入、传输与访问"
        lead={solution.solution.join(" ")}
      />

      {pillars.length > 0 && (
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {pillars.map((pillar, index) => (
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6">
              <span class="font-mono text-[0.6875rem] tracking-wider text-white/65">
                0{index + 1}
              </span>
              <h3 class="mt-4 text-lg font-semibold text-white">
                {pillar.title}
              </h3>
              <p class="mt-2 text-sm leading-6 text-white/65">
                {pillar.description}
              </p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <SectionHeading
        eyebrow="方案应用"
        title="轻量落地，与现有系统协同"
        lead="从 SDK 集成到网关协同，方案围绕现有业务系统展开，尽量减少改造范围。"
      />

      <div class="mt-10 grid gap-4 lg:grid-cols-2">
        {solution.values.map((value, index) => (
          <div class="card relative overflow-hidden p-6 sm:p-7">
            <div class="flex items-center justify-between">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <Icon name={valueIcons[index] ?? "check"} size={19} />
              </span>
              <span class="font-mono text-[0.6875rem] tracking-wider text-muted">
                0{index + 1}
              </span>
            </div>
            <h3 class="mt-5 text-lg font-semibold text-ink-900">
              {value.title}
            </h3>
            <p class="mt-2 text-sm leading-6 text-muted">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-10 rounded-3xl border border-line bg-white p-8 sm:p-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:p-12">
      <SectionHeading
        eyebrow="适用场景"
        title="在复杂业务环境中保持安全与可用"
        lead={solution.scenarios}
      />
      <ul class="flex flex-wrap gap-2 lg:justify-end">
        {solution.scenarioTags.map((tag) => (
          <li class="rounded-full border border-line bg-paper px-3.5 py-1.5 text-sm text-ink-900/65">
            {tag}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading eyebrow="相关方案" title="继续了解其他接入安全方案" />
        <a
          href="/#solutions"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition hover:text-brand-700"
        >
          查看全部方案
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {related.map((item, index) => (
          <SolutionCard solution={item} index={index + 1} tone="light" />
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import HomeHero from "@/components/HomeHero.astro";
import NewsRow from "@/components/NewsRow.astro";
import ProductCard from "@/components/ProductCard.astro";
import Icon from "@/components/ui/Icon.astro";
import IndustryMarquee from "@/components/IndustryMarquee.astro";
import { ecosystem, services, valueCards } from "@/data/home";
import { products } from "@/data/products";
import { solutions } from "@/data/solutions";
import "@/styles/home-contrast.css";
const newsEntries = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="联易软件｜ZSAC 接入安全，国密接入安全体系"
  description="联易软件聚焦国产动态软件密码接入安全体系建设，以 ZSAC 接入安全机制为多形态终端、数据共享与用户认证提供合规、易用、有效的密码安全服务。"
  bodyClass="home-page"
>
  <HomeHero />
  <section class="trust-statement-section" aria-label="联易的接入安全理念">
    <div class="container-page trust-statement-layout">
      <div class="statement-side" data-reveal>
        <p class="eyebrow">信任，从连接开始</p>
        <a class="text-link" href="/about/">
          联易的专注 <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
      <div class="statement-copy">
        <p class="scroll-statement" data-scroll-fill>
          让每一台设备拥有可信身份，让每一次访问经过安全认证。
        </p>
        <p class="statement-support">
          以自主密码技术，把复杂的接入，变成可靠的连接。
        </p>
      </div>
    </div>
  </section>
  <section class="section ecosystem-section" id="ecosystem">
    <div class="container-page ecosystem-layout">
      <div class="ecosystem-copy">
        <p class="eyebrow" data-reveal>
          连接有界，信任无间
        </p>
        <h2 class="section-title" data-reveal>
          复杂的接入，
          <br />
          统一的安全底座。
        </h2>
        <p class="section-lead" data-reveal>
          从设备身份到用户权限，从应用访问到统一授权，让每一次连接都沿着同一条密码信任链展开。
        </p>
        <a class="text-link" href="/products/zsac-crypto-module/" data-reveal>
          了解核心机制 <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
      <div class="ecosystem-shell" data-reveal>
        <div class="ecosystem-core">
          <div class="ecosystem-banner">
            <strong>一个 ZSAC，连接每一端。</strong>
            <span>设备 · 用户 · 应用 · 授权</span>
          </div>
          <div class="ecosystem-items">
            {ecosystem.map((item) => (
              <div>
                <Icon name={item.icon} size={23} strokeWidth={1.3} />
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            ))}
          </div>
          <div class="ecosystem-base">
            <Icon name="key" size={18} />
            <span>自主动态软件密码技术</span>
            <span>统一信任基础</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section products-section" id="products">
    <div class="container-page">
      <div class="section-header">
        <div>
          <p class="eyebrow" data-reveal>
            产品中心
          </p>
          <h2 class="section-title" data-reveal>
            把安全能力，
            <br />
            落实到每一次接入。
          </h2>
        </div>
        <div class="section-header-side" data-reveal>
          <p>
            从终端准入到应用保护，
            <br />
            按需组合，构建完整产品体系。
          </p>
          <a class="text-link" href="/contact/">
            获取产品资料 <Icon name="arrow-up-right" size={18} />
          </a>
        </div>
      </div>
      <div class="product-grid">
        {products.map((product, index) => (
          <ProductCard product={product} index={index + 1} />
        ))}
      </div>
    </div>
  </section>
  <section class="section solutions-section" id="solutions">
    <div class="container-page">
      <div class="section-header">
        <div>
          <p class="eyebrow" data-reveal>
            解决方案
          </p>
          <h2 class="section-title" data-reveal>
            从实际场景，
            <br />
            找到安全的解法。
          </h2>
        </div>
        <p class="section-header-side" data-reveal>
          围绕终端、数据与应用，
          <br />
          提供可落地的接入安全路径。
        </p>
      </div>
      <div class="solution-selector" data-solution-selector>
        <div class="solution-options" aria-label="选择安全场景">
          {solutions.map((solution, index) => (
            <div
              class="solution-option"
              data-selected={index === 0 ? "true" : "false"}
              data-reveal
            >
              <button
                type="button"
                aria-pressed={index === 0 ? "true" : "false"}
                data-solution-choice={index}
                aria-controls="solution-preview"
              >
                <span>{solution.name}</span>
                <Icon name="arrow-up-right" size={22} />
              </button>
              <p>{solution.tagline}</p>
              <a class="text-link" href={`/solutions/${solution.slug}/`}>
                查看解决方案 <Icon name="arrow-right" size={16} />
              </a>
            </div>
          ))}
        </div>
        <div class="solution-preview-shell" data-reveal>
          <div
            class="solution-preview"
            id="solution-preview"
            aria-live="polite"
          >
            {solutions.map((solution, index) => (
              <div data-solution-panel={index} hidden={index !== 0}>
                <div class="solution-image">
                  <img
                    src={solution.heroImage}
                    alt={solution.heroAlt}
                    width="900"
                    height="500"
                    loading="eager"
                  />
                </div>
                <div class="solution-preview-copy">
                  <span>ZSAC 场景方案</span>
                  <strong>{solution.name}</strong>
                  <p>{solution.solution[0]}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <IndustryMarquee />
    </div>
  </section>
  <section class="section values-section">
    <div class="container-page">
      <div class="values-heading">
        <p class="eyebrow" data-reveal>
          为什么选择联易
        </p>
        <h2 class="section-title" data-reveal>
          好的安全，
          <br />
          也应该简单易用。
        </h2>
        <p data-reveal>
          以软密码模块为核心，兼顾安全要求与部署成本，让密码技术更好地服务业务。
        </p>
      </div>
      <div class="value-list">
        {valueCards.map((value) => (
          <article data-reveal>
            <div class="value-core">
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="service-strip" data-reveal>
        {services.map((service) => (
          <div>
            <Icon name={service.icon} size={22} strokeWidth={1.3} />
            <span>
              <strong>{service.title}</strong>
              <span>{service.subtitle}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section news-section" id="news">
    <div class="container-page">
      <div class="section-header">
        <div>
          <p class="eyebrow" data-reveal>
            新闻动态
          </p>
          <h2 class="section-title" data-reveal>
            关注此刻，思考下一步。
          </h2>
        </div>
        <a class="text-link" href="/news/" data-reveal>
          查看全部资讯 <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
      <div class="home-news-list">
        {newsEntries.length ? (
          newsEntries.map((entry, index) => (
            <div
              class:list={["home-news-item", index === 0 && "is-featured"]}
              data-reveal
            >
              <NewsRow
                title={entry.data.title}
                summary={entry.data.summary}
                date={entry.data.date}
                href={`/news/${entry.id}/`}
                source={entry.data.source}
                featured={index === 0}
              />
            </div>
          ))
        ) : (
          <p>资讯内容正在整理中。</p>
        )}
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-solution-selector]")
    .forEach((selector) => {
      const choices = selector.querySelectorAll<HTMLButtonElement>(
        "[data-solution-choice]",
      );
      choices.forEach((choice) =>
        choice.addEventListener("click", () => {
          choices.forEach((button) => {
            const selected = button === choice;
            button.setAttribute("aria-pressed", String(selected));
            button.closest<HTMLElement>(".solution-option")!.dataset.selected =
              String(selected);
          });
          selector
            .querySelectorAll<HTMLElement>("[data-solution-panel]")
            .forEach((panel) => {
              panel.hidden =
                panel.dataset.solutionPanel !== choice.dataset.solutionChoice;
            });
        }),
      );
    });
</script>

---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import { getPublishedNews, type NewsEntry } from '@/lib/news';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const news = await getPublishedNews();
  return news.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const news = await getPublishedNews();
const index = news.findIndex((item) => item.id === entry.id);
const newer = index > 0 ? news[index - 1] : null;
const older = index >= 0 && index < news.length - 1 ? news[index + 1] : null;
const related = news
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => {
    const aSameYear = a.data.date.getFullYear() === entry.data.date.getFullYear() ? 1 : 0;
    const bSameYear = b.data.date.getFullYear() === entry.data.date.getFullYear() ? 1 : 0;
    if (aSameYear !== bSameYear) return bSameYear - aSameYear;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const pageUrl = new URL(`/news/${entry.id}/`, site.url).href;
const published = entry.data.date.toISOString();
const cover = entry.data.cover ? new URL(entry.data.cover, site.url).href : `${site.url}/images/home/hero-3.webp`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: published,
  dateModified: published,
  inLanguage: 'zh-CN',
  articleSection: '新闻动态',
  author: {
    '@type': 'Organization',
    name: site.legalName,
    url: site.url,
  },
  publisher: {
    '@type': 'Organization',
    name: site.legalName,
    logo: {
      '@type': 'ImageObject',
      url: `${site.url}/images/logo.png`,
    },
  },
  image: [cover],
  mainEntityOfPage: pageUrl,
  url: pageUrl,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: '新闻动态', item: `${site.url}/news/` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
  ],
};

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.date);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  canonical={`/news/${entry.id}/`}
  type="article"
  image={entry.data.cover}
  jsonLd={[breadcrumbJsonLd, articleJsonLd]}
>
  <div class="border-b border-line bg-white">
    <div class="container-page py-6">
      <Breadcrumbs
        items={[
          { label: '首页', href: '/' },
          { label: '新闻动态', href: '/news/' },
          { label: entry.data.title },
        ]}
      />
    </div>
  </div>

  <article>
    <header class="bg-white pb-8 pt-10 lg:pt-14">
      <div class="container-page">
        <div class="max-w-3xl">
          <p class="eyebrow">新闻动态</p>
          <h1 class="mt-4 text-[1.75rem] font-semibold leading-[1.3] tracking-[-0.015em] text-ink-900 sm:text-4xl lg:text-[2.65rem]">
            {entry.data.title}
          </h1>
          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
            <time datetime={published} class="inline-flex items-center gap-1.5">
              <Icon name="calendar" size={14} />
              {formattedDate}
            </time>
            {entry.data.source && (
              <span class="inline-flex items-center gap-1.5">
                <Icon name="file" size={14} />
                来源：{entry.data.source}
              </span>
            )}
            <button
              type="button"
              class="inline-flex items-center gap-1.5 text-brand-600 transition hover:text-brand-700"
              data-copy-link
            >
              <Icon name="copy" size={14} />
              复制链接
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="container-page pb-16 lg:pb-24">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,48rem)_15rem] lg:justify-center lg:gap-12">
        <div class="min-w-0">
          {
            entry.data.cover && (
              <img
                src={entry.data.cover}
                alt={entry.data.coverAlt ?? entry.data.title}
                width="1200"
                height="675"
                class="mb-8 aspect-[16/9] w-full rounded-2xl object-cover"
                loading="eager"
                decoding="async"
              />
            )
          }

          <div class="prose-news" data-article-body>
            <Content />
          </div>

          <aside class="mt-10 rounded-xl border border-line bg-white px-5 py-4 text-xs leading-6 text-muted" aria-label="免责声明">
            注：内容均来源于互联网，版权归作者所有，如有侵权，请联系告知，我们将尽快处理。
          </aside>

          <nav class="mt-10 grid gap-3 border-t border-line pt-8 sm:grid-cols-2" aria-label="上一篇与下一篇">
            {
              newer ? (
                <a href={`/news/${newer.id}/`} class="group rounded-xl border border-line bg-white p-4 transition hover:border-brand-500/40">
                  <span class="text-xs text-muted">上一篇</span>
                  <span class="mt-1 block text-sm font-semibold text-ink-900 transition group-hover:text-brand-600">
                    {newer.data.title}
                  </span>
                </a>
              ) : (
                <span class="rounded-xl border border-line bg-white p-4 text-xs text-muted">已经是第一篇</span>
              )
            }
            {
              older ? (
                <a href={`/news/${older.id}/`} class="group rounded-xl border border-line bg-white p-4 text-right transition hover:border-brand-500/40">
                  <span class="text-xs text-muted">下一篇</span>
                  <span class="mt-1 block text-sm font-semibold text-ink-900 transition group-hover:text-brand-600">
                    {older.data.title}
                  </span>
                </a>
              ) : (
                <span class="rounded-xl border border-line bg-white p-4 text-right text-xs text-muted">已经是最后一篇</span>
              )
            }
          </nav>

          {
            related.length > 0 && (
              <section class="mt-12" aria-labelledby="related-news">
                <div class="flex items-end justify-between gap-4">
                  <h2 id="related-news" class="text-xl font-semibold text-ink-900">相关阅读</h2>
                  <a href="/news/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition hover:text-brand-700">
                    全部资讯
                    <Icon name="arrow-right" size={14} />
                  </a>
                </div>
                <div class="mt-4">
                  {related.map((item) => (
                    <a href={`/news/${item.id}/`} class="group flex flex-col gap-1 border-b border-line py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
                      <span class="text-sm font-semibold text-ink-900 transition group-hover:text-brand-600">
                        {item.data.title}
                      </span>
                      <time datetime={item.data.date.toISOString()} class="shrink-0 font-mono text-xs text-muted">
                        {new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(item.data.date)}
                      </time>
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </div>

        <aside class="hidden lg:block" aria-label="文章目录">
          {
            toc.length > 0 && (
              <div class="sticky top-24">
                <p class="text-xs font-semibold tracking-[0.16em] text-muted">本文目录</p>
                <nav class="mt-3 border-l border-line">
                  <ul class="space-y-1.5">
                    {toc.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.slug}`}
                          class:list={[
                            'block border-l-2 py-1 text-sm leading-5 text-muted transition hover:border-brand-500 hover:text-brand-600',
                            heading.depth === 2 ? '-ml-px border-transparent pl-3' : '-ml-px border-transparent pl-6 text-xs',
                          ]}
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </article>

  <dialog
    id="article-image-dialog"
    class="m-auto max-h-[90vh] max-w-[min(72rem,calc(100vw-2rem))] overflow-hidden rounded-2xl border border-line bg-white p-0 shadow-menu backdrop:bg-ink-950/70"
    aria-label="查看大图"
  >
    <div class="flex justify-end border-b border-line px-3 py-2">
      <button type="button" class="flex h-8 w-8 items-center justify-center rounded-full text-ink-900/50 transition hover:bg-paper" aria-label="关闭大图" data-image-close>
        <Icon name="close" size={18} />
      </button>
    </div>
    <img
      id="article-image-large"
      src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
      alt=""
      class="max-h-[80vh] w-auto max-w-full object-contain"
    />
  </dialog>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  copyButton?.addEventListener('click', async () => {
    const original = copyButton.innerHTML;
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyButton.textContent = '已复制';
      window.setTimeout(() => {
        copyButton.innerHTML = original;
      }, 2000);
    } catch {
      window.prompt('复制此链接', window.location.href);
    }
  });

  const dialog = document.querySelector<HTMLDialogElement>('#article-image-dialog');
  const largeImage = document.querySelector<HTMLImageElement>('#article-image-large');
  const closeButton = document.querySelector<HTMLElement>('[data-image-close]');
  const articleBody = document.querySelector<HTMLElement>('[data-article-body]');

  articleBody?.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
    image.classList.add('cursor-zoom-in');
    image.addEventListener('click', () => {
      if (!dialog || !largeImage) return;
      largeImage.src = image.currentSrc || image.src;
      largeImage.alt = image.alt;
      dialog.showModal();
    });
  });

  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

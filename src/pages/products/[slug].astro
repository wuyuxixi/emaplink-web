---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import ProductCard from '@/components/ProductCard.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { products, type Product } from '@/data/products';
import { site } from '@/data/site';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const features = product.features ?? [];
const advantages = product.advantages ?? [];
const mechanisms = product.mechanisms ?? [];
const capabilities = product.capabilities ?? [];
const scenarioTags = product.scenarioTags ?? [];
const asideItems = features.length
  ? features.slice(0, 3).map((item) => item.title)
  : advantages.length
    ? advantages.slice(0, 3).map((item) => item.title)
    : mechanisms.slice(0, 3).map((item) => item.title);

const pageUrl = new URL(`/products/${product.slug}/`, site.url).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: '产品中心', item: `${site.url}/#products` },
    { '@type': 'ListItem', position: 3, name: product.name, item: pageUrl },
  ],
};

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.metaDescription,
  brand: { '@type': 'Brand', name: site.name },
  category: '接入安全',
  url: pageUrl,
};

const related = products.filter((item) => item.slug !== product.slug).slice(0, 3);
const mechanismIcons = ['shield', 'key', 'network', 'spark'] as const;
---

<BaseLayout
  title={product.name}
  description={product.metaDescription}
  jsonLd={[breadcrumbJsonLd, productJsonLd]}
>
  <PageHero
    eyebrow="产品中心"
    title={product.name}
    description={product.tagline}
    breadcrumbs={[
      { label: '首页', href: '/' },
      { label: '产品中心', href: '/#products' },
      { label: product.name },
    ]}
    asideItems={asideItems}
  />

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
      <div>
        <p class="eyebrow">产品介绍</p>
        <h2 class="section-title mt-4">{product.shortName}</h2>
        {scenarioTags.length > 0 && (
          <div class="mt-6 rounded-2xl border border-line bg-white p-5">
            <p class="text-xs font-semibold tracking-[0.14em] text-muted">适用行业</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {scenarioTags.slice(0, 6).map((tag) => (
                <span class="rounded-full bg-paper px-3 py-1 text-xs text-ink-900/65">{tag}</span>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="space-y-5 text-base leading-8 text-muted">
        {product.intro.map((paragraph) => <p>{paragraph}</p>)}
        <a
          href="/contact/"
          class="inline-flex items-center gap-1.5 pt-2 text-sm font-semibold text-brand-600 transition hover:text-brand-700"
        >
          获取产品资料
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>

  {
    features.length > 0 && (
      <section class="section bg-white">
        <div class="container-page">
          <SectionHeading
            eyebrow="产品功能"
            title="从身份到准入的完整能力"
            lead="围绕可信身份、准入控制、状态管理与风险感知，形成可落地的产品能力组合。"
          />

          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {features.map((feature, index) => (
              <div class="card p-6">
                <span class="font-mono text-[0.6875rem] tracking-wider text-muted">
                  0{index + 1}
                </span>
                <h3 class="mt-4 text-base font-semibold text-ink-900">{feature.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted">{feature.description}</p>
              </div>
            ))}

            <a
              href="/contact/"
              class="group flex flex-col justify-between rounded-2xl bg-ink-950 p-6 text-white transition hover:bg-ink-900 sm:col-span-2 lg:col-span-2"
            >
              <div>
                <p class="text-xs font-semibold tracking-[0.16em] text-white/65">产品资料</p>
                <p class="mt-3 text-lg font-semibold leading-7">需要更完整的功能清单与部署说明？</p>
              </div>
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-cyan-400">
                联系我们获取
                <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    capabilities.length > 0 && (
      <section class="section">
        <div class="container-page grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
          <SectionHeading
            eyebrow="核心能力"
            title="把动态口令做成可落地的身份鉴别能力"
            lead="面向 WEB 系统的多因素认证，兼顾安全性与使用体验。"
          />
          <ul class="space-y-4">
            {capabilities.map((capability, index) => (
              <li class="flex items-start gap-4 rounded-2xl border border-line bg-white p-5">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-mono text-xs font-semibold text-brand-700">
                  0{index + 1}
                </span>
                <p class="text-base leading-7 text-ink-900/80">{capability}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    mechanisms.length > 0 && (
      <section class="section bg-white">
        <div class="container-page">
          <SectionHeading
            eyebrow="核心机制"
            title="从信任、密码、传输到进化，构成 ZSAC 的底层逻辑"
            lead="ZSAC 不是单一产品，而是一套可持续演进的接入安全机制。"
          />

          <div class="mt-10 grid gap-4 lg:grid-cols-2">
            {mechanisms.map((mechanism, index) => (
              <div class="card p-6 sm:p-7">
                <div class="flex items-center justify-between">
                  <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-ink-950 text-cyan-400">
                    <Icon name={mechanismIcons[index] ?? 'shield'} size={19} />
                  </span>
                  <span class="font-mono text-[0.6875rem] tracking-wider text-muted">
                    0{index + 1}
                  </span>
                </div>
                <h3 class="mt-5 text-lg font-semibold text-ink-900">{mechanism.title}</h3>
                <ul class="mt-4 space-y-3">
                  {mechanism.points.map((point) => (
                    <li class="flex items-start gap-2.5 text-sm leading-6 text-muted">
                      <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    product.ecosystem && (
      <section class="section">
        <div class="container-page">
          <div class="relative overflow-hidden rounded-3xl bg-ink-950 p-8 text-white sm:p-10 lg:p-14">
            <div
              class="pointer-events-none absolute inset-0 opacity-[0.07]"
              style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 64px 64px;"
              aria-hidden="true"
            ></div>
            <div class="relative grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
              <div>
                <p class="eyebrow text-cyan-400">ZSAC 接入安全生态</p>
                <p class="mt-4 max-w-2xl text-2xl font-semibold leading-relaxed sm:text-3xl">
                  {product.ecosystem}
                </p>
              </div>
              <div class="flex justify-start lg:justify-end">
                <img
                  src="/images/products/zsac-crypto-module/diagram.webp"
                  alt="ZSAC 标识"
                  width="312"
                  height="296"
                  class="h-36 w-36 rounded-2xl bg-white object-contain p-3"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    advantages.length > 0 && (
      <section class="section bg-white">
        <div class="container-page">
          <SectionHeading
            eyebrow="产品优势"
            title="安全、易用、合规、经济"
            lead="以软密码模块形态，把安全能力做成可复制、可规模化的产品能力。"
          />
          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {advantages.map((advantage, index) => (
              <div class="card p-6">
                <span class="font-mono text-[0.6875rem] tracking-wider text-muted">
                  0{index + 1}
                </span>
                <h3 class="mt-4 text-base font-semibold text-ink-900">{advantage.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted">{advantage.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    product.scenarios && (
      <section class="relative overflow-hidden bg-ink-950 py-20 text-white">
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.07]"
          style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 72px 72px;"
          aria-hidden="true"
        ></div>
        <div class="container-page relative grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <SectionHeading
            tone="dark"
            eyebrow="适用场景"
            title="适配多行业、多形态的接入场景"
            lead={product.scenarios}
          />
          <ul class="flex flex-wrap gap-2 lg:justify-end">
            {scenarioTags.map((tag) => (
              <li class="rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-sm text-white/70">
                {tag}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading eyebrow="相关产品" title="继续了解完整产品矩阵" />
        <a
          href="/#products"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition hover:text-brand-700"
        >
          查看全部产品
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((item, index) => <ProductCard product={item} index={index + 1} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

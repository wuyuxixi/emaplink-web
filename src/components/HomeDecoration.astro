};
const { height, frames, routes } = artwork[variant];
---

<div class:list={['home-decoration', `home-decoration--${variant}`]} data-home-decoration={variant} aria-hidden="true">
  <div class="trust-scroll-layer">
    <div class="trust-pointer-layer">
      <svg class="trust-artwork" viewBox={`0 0 1440 ${height}`} fill="none" preserveAspectRatio="none" focusable="false">
        {frames.map((frame, index) => (
          <g class="trust-frame" data-frame={index}>
            <g transform={`rotate(${frame.rotate ?? 0} ${frame.x + frame.w / 2} ${frame.y + frame.h / 2})`}>
              <rect class="trust-frame-field" x={frame.x} y={frame.y} width={frame.w} height={frame.h} rx={frame.r} />
              <rect class="trust-frame-edge" x={frame.x} y={frame.y} width={frame.w} height={frame.h} rx={frame.r} vector-effect="non-scaling-stroke" />
              <rect class="trust-frame-inset" x={frame.x + 16} y={frame.y + 16} width={frame.w - 32} height={frame.h - 32} rx={frame.r - 16} vector-effect="non-scaling-stroke" />
            </g>
          </g>
        ))}
        {routes.map((route, index) => (
          <g class="trust-route" data-route={index}>
            <path class="trust-route-track" d={route.d} vector-effect="non-scaling-stroke" />
            <path class="trust-route-signal" d={route.d} pathLength="1" vector-effect="non-scaling-stroke" />
          </g>
        ))}
      </svg>
      {routes.map((route, index) => (
        <span class="trust-route trust-terminal" data-route={index} style={`left:${route.end[0] / 1440 * 100}%;top:${route.end[1] / height * 100}%`}>
          <span class="trust-terminal-ring"></span>
          <span class="trust-terminal-core"></span>
        </span>
      ))}
    </div>
  </div>
</div>

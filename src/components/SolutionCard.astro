---
import type { Solution } from "@/data/solutions";
import Icon from "./ui/Icon.astro";
interface Props {
  solution: Solution;
  index: number;
  tone?: "dark" | "light";
}
const { solution } = Astro.props;
---

<a href={`/solutions/${solution.slug}/`} class="related-solution" data-reveal>
  <div>
    <img
      src={solution.heroImage}
      alt={solution.heroAlt}
      width="900"
      height="500"
      loading="lazy"
      decoding="async"
    />
    <div>
      <h3>{solution.name}</h3>
      <p>{solution.tagline}</p>
      <span class="text-link">
        了解方案 <Icon name="arrow-up-right" size={18} />
      </span>
    </div>
  </div>
</a>

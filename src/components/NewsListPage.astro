---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import NewsRow from '@/components/NewsRow.astro';
import Pagination from '@/components/Pagination.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';

interface Props {
  items: CollectionEntry<'news'>[];
  page: number;
  totalPages: number;
}

const { items, page, totalPages } = Astro.props;

const pageUrl = page === 1 ? `${site.url}/news/` : `${site.url}/news/page/${page}/`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: '新闻动态', item: `${site.url}/news/` },
    ...(page > 1
      ? [{ '@type': 'ListItem', position: 3, name: `第 ${page} 页`, item: pageUrl }]
      : []),
  ],
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: page === 1 ? '新闻动态' : `新闻动态 · 第 ${page} 页`,
  description: '联易软件新闻动态，关注密码技术、数据安全与接入安全的政策、趋势与落地实践。',
  url: pageUrl,
};
---

<BaseLayout
  title={page === 1 ? '新闻动态' : `新闻动态 · 第 ${page} 页`}
  description="联易软件新闻动态，关注密码技术、数据安全与接入安全的政策、趋势与落地实践。"
  canonical={page === 1 ? '/news/' : `/news/page/${page}/`}
  jsonLd={[breadcrumbJsonLd, collectionJsonLd]}
>
  <PageHero
    eyebrow="新闻动态"
    title="了解企业资讯，洞察行业趋势"
    description="关注密码技术、数据安全与接入安全的政策变化、行业趋势与落地实践。"
    breadcrumbs={[
      { label: '首页', href: '/' },
      ...(page > 1 ? [{ label: '新闻动态', href: '/news/' }, { label: `第 ${page} 页` }] : [{ label: '新闻动态' }]),
    ]}
    compact
  />

  <section class="section">
    <div class="container-page">
      <div class="flex flex-col gap-4 border-b border-line pb-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted">
          共 <span class="font-semibold text-ink-900">{items.length}</span> 条
          {totalPages > 1 && <span> · 第 {page} / {totalPages} 页</span>}
        </p>
        <button
          type="button"
          class="inline-flex items-center gap-2 self-start rounded-full border border-line bg-white px-4 py-2 text-sm text-ink-900/65 transition hover:border-brand-500 hover:text-brand-600 sm:self-auto"
          data-search-open
        >
          <Icon name="search" size={15} />
          搜索资讯
        </button>
      </div>

      {
        items.length > 0 ? (
          <div data-news-list>
            {items.map((entry, index) => (
              <NewsRow
                title={entry.data.title}
                summary={entry.data.summary}
                date={entry.data.date}
                href={`/news/${entry.id}/`}
                source={entry.data.source}
                featured={page === 1 && index === 0}
              />
            ))}
          </div>
        ) : (
          <div class="py-20 text-center">
            <p class="text-base font-semibold text-ink-900">暂无资讯</p>
            <p class="mt-2 text-sm text-muted">内容正在整理中，欢迎稍后再来。</p>
          </div>
        )
      }

      <Pagination current={page} total={totalPages} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

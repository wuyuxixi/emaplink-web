---
import Breadcrumbs from "./Breadcrumbs.astro";
import Icon from "./Icon.astro";
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  breadcrumbs: { label: string; href?: string }[];
  asideLabel?: string;
  asideItems?: string[];
  compact?: boolean;
  class?: string;
}
const {
  eyebrow,
  title,
  description,
  breadcrumbs,
  asideLabel = "核心能力",
  asideItems,
  compact = false,
  class: className = "",
} = Astro.props;
---

<section class:list={["page-hero", compact && "page-hero-compact", className]}>
  <div class="container-page">
    <Breadcrumbs items={breadcrumbs} />
    <div class="page-hero-layout">
      <div>
        <p class="eyebrow" data-reveal>
          {eyebrow}
        </p>
        <h1 data-reveal>{title}</h1>
        {description && (
          <p class="page-hero-description" data-reveal>
            {description}
          </p>
        )}
        <slot />
      </div>
      {asideItems?.length && (
        <div class="page-capabilities" data-reveal>
          <div>
            <p>{asideLabel}</p>
            <ul>
              {asideItems.map((item) => (
                <li>
                  <Icon name="check" size={18} strokeWidth={1.3} />
                  {item}
                </li>
              ))}
            </ul>
            <span>ZSAC · 接入安全体系</span>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

---
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  breadcrumbs: { label: string; href?: string }[];
  asideLabel?: string;
  asideItems?: string[];
  compact?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  breadcrumbs,
  asideLabel = '核心能力',
  asideItems,
  compact = false,
  class: className = '',
} = Astro.props;
---

<section class:list={['relative overflow-hidden bg-ink-950 text-white', className]}>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 72px 72px;"
    aria-hidden="true"
  ></div>
  <div class="pointer-events-none absolute -right-24 top-0 h-80 w-80 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-cyan-400/10 blur-3xl" aria-hidden="true"></div>

  <div class:list={['container-page relative', compact ? 'py-10 lg:py-12' : 'py-14 lg:py-20']}>
    <Breadcrumbs items={breadcrumbs} tone="dark" />

    <div class:list={['mt-8 grid gap-10', asideItems?.length && 'lg:grid-cols-[1.15fr_0.85fr] lg:items-end']}>
      <div>
        <p class="eyebrow text-cyan-400">{eyebrow}</p>
        <h1 class:list={['mt-4 max-w-4xl font-semibold leading-[1.12] tracking-[-0.02em] text-white', compact ? 'text-3xl sm:text-4xl' : 'text-[2.1rem] sm:text-5xl lg:text-[3.2rem]']}>
          {title}
        </h1>
        {description && (
          <p class="mt-5 max-w-2xl text-base leading-8 text-white/60 sm:text-lg">
            {description}
          </p>
        )}
        <slot />
      </div>

      {asideItems?.length && (
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur sm:p-6">
          <div
            class="pointer-events-none absolute -right-8 -top-8 h-28 w-28 rounded-full bg-cyan-400/10 blur-2xl"
            aria-hidden="true"
          ></div>
          <p class="text-xs font-semibold tracking-[0.16em] text-white/65">{asideLabel}</p>
          <ul class="mt-4 space-y-3">
            {
              asideItems.map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-6 text-white/70">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cyan-400/10 text-cyan-400">
                    <Icon name="check" size={12} />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

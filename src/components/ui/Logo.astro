---
interface Props {
  tone?: 'on-light' | 'on-dark';
  class?: string;
  href?: string;
}

const { tone = 'on-light', class: className = '', href = '/' } = Astro.props;
---

<a
  href={href}
  aria-label="联易软件首页"
  class:list={[
    'inline-flex items-center',
    tone === 'on-dark' && 'rounded-lg bg-white px-3 py-2 shadow-sm',
    className,
  ]}
>
  <img
    src="/images/logo.png"
    alt="联易软件 emaplink"
    width="166"
    height="64"
    class:list={[
      'w-auto',
      tone === 'on-light' ? 'h-10' : 'h-9',
    ]}
    loading="eager"
    decoding="async"
  />
</a>

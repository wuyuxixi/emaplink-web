---
import type { Product } from "@/data/products";
import Icon from "./ui/Icon.astro";
import ProductVisual from "./ProductVisual.astro";
interface Props {
  product: Product;
  index: number;
}
const { product } = Astro.props;
const categories: Record<string, string> = {
  "zsac-gateway": "终端准入",
  "zsac-server": "应用接入",
  "zsac-crypto-module": "密码能力",
  "zsac-otp": "身份认证",
};
---

<a href={`/products/${product.slug}/`} class="product-card" data-reveal>
  <div class="product-card-core">
    <div class="product-card-media">
      <ProductVisual slug={product.slug} />
      <span>{categories[product.slug]}</span>
    </div>
    <div class="product-card-copy">
      <h3>{product.shortName}</h3>
      <p>{product.tagline}</p>
      <span class="product-card-link">
        了解产品{" "}
        <span>
          <Icon name="arrow-up-right" size={19} />
        </span>
      </span>
    </div>
  </div>
</a>

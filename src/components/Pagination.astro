---
interface Props {
  current: number;
  total: number;
  basePath?: string;
  pagePrefix?: string;
}

const { current, total, basePath = '/news/', pagePrefix = '/news/page/' } = Astro.props;

const hrefFor = (page: number) => (page === 1 ? basePath : `${pagePrefix}${page}/`);

const pages = Array.from({ length: total }, (_, index) => index + 1).filter((page) => {
  if (total <= 7) return true;
  return page === 1 || page === total || Math.abs(page - current) <= 1;
});
---

{
  total > 1 && (
    <nav aria-label="分页" class="mt-10 flex items-center justify-center gap-1.5">
      {current > 1 ? (
        <a
          href={hrefFor(current - 1)}
          class="flex h-9 items-center rounded-full border border-line bg-white px-3.5 text-sm text-ink-900/65 transition hover:border-brand-500 hover:text-brand-600"
          rel="prev"
        >
          上一页
        </a>
      ) : (
        <span class="flex h-9 items-center rounded-full border border-line px-3.5 text-sm text-ink-900/25">
          上一页
        </span>
      )}

      {pages.map((page, index) => {
        const previous = pages[index - 1];
        const gap = previous && page - previous > 1;
        return (
          <Fragment>
            {gap && <span class="px-1 text-sm text-muted">…</span>}
            <a
              href={hrefFor(page)}
              aria-current={page === current ? 'page' : undefined}
              class:list={[
                'flex h-9 min-w-9 items-center justify-center rounded-full px-2 text-sm transition',
                page === current
                  ? 'bg-ink-950 font-semibold text-white'
                  : 'border border-line bg-white text-ink-900/65 hover:border-brand-500 hover:text-brand-600',
              ]}
            >
              {page}
            </a>
          </Fragment>
        );
      })}

      {current < total ? (
        <a
          href={hrefFor(current + 1)}
          class="flex h-9 items-center rounded-full border border-line bg-white px-3.5 text-sm text-ink-900/65 transition hover:border-brand-500 hover:text-brand-600"
          rel="next"
        >
          下一页
        </a>
      ) : (
        <span class="flex h-9 items-center rounded-full border border-line px-3.5 text-sm text-ink-900/25">
          下一页
        </span>
      )}
    </nav>
  )
}

---
import { footerNav, site } from "@/data/site";
import Icon from "./ui/Icon.astro";
---

<footer class="site-footer">
  <div class="footer-atmosphere" aria-hidden="true"></div>
  <div class="footer-dot-field" aria-hidden="true"></div>
  <svg
    class="footer-globe"
    viewBox="0 0 600 600"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="300" cy="300" r="250" />
    <g class="footer-globe-grid">
      <ellipse cx="300" cy="300" rx="80" ry="250" />
      <ellipse cx="300" cy="300" rx="160" ry="250" />
      <ellipse cx="300" cy="300" rx="222" ry="250" />
      <ellipse cx="300" cy="300" rx="250" ry="70" />
      <ellipse cx="300" cy="300" rx="250" ry="150" />
      <ellipse cx="300" cy="300" rx="250" ry="215" />
      <path d="M50 300h500M300 50v500" />
    </g>
    <ellipse
      class="footer-globe-orbit"
      cx="300"
      cy="300"
      rx="283"
      ry="102"
      transform="rotate(-28 300 300)"
    />
  </svg>
  <div class="container-page">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="联易软件首页">
          <img
            src="/images/logo-footer.png"
            alt="联易软件 emaplink"
            width="217"
            height="82"
            loading="eager"
            decoding="async"
          />
        </a>
        <p>
          联于政通，易于人和。
          <br />
          以密码技术，连接可信的数字世界。
        </p>
        <a href={site.emailHref}>
          {site.email} <Icon name="arrow-up-right" size={16} />
        </a>
        <p class="footer-address">{site.address}</p>
      </div>
      <nav aria-label="底部产品导航">
        <h2>产品与方案</h2>
        {footerNav.products.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href="/#solutions">
          探索解决方案 <Icon name="arrow-up-right" size={14} />
        </a>
      </nav>
      <nav aria-label="底部公司导航">
        <h2>了解联易</h2>
        {footerNav.about.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </div>
    <div class="footer-wordmark" aria-hidden="true">
      emaplink<span>®</span>
    </div>
    <div class="footer-bottom">
      <span>{site.copyright}</span>
      <a href={site.icpUrl} target="_blank" rel="noopener noreferrer">
        {site.icp}
      </a>
      <a href="#top">
        回到顶部 <Icon name="top" size={16} />
      </a>
    </div>
  </div>
</footer>

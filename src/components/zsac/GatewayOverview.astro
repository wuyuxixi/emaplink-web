---
import ButtonLink from "../ui/ButtonLink.astro";
import Icon from "../ui/Icon.astro";
import DeviceGlyph from "./DeviceGlyph.astro";
import RenderedAsset from "./RenderedAsset.astro";

const terminals = [
  {
    kind: "phone",
    name: "手机",
    description:
      "将软密码模块集成到移动终端，与设备指纹绑定，通过双向认证建立可信连接。",
  },
  {
    kind: "drone",
    name: "无人机",
    description:
      "以低功耗软密码模块适配无人机终端，在接入时完成身份鉴别，持续管理终端接入状态。",
  },
  {
    kind: "camera",
    name: "执法记录仪",
    description:
      "为执法记录终端绑定可信身份，依据准入策略识别合法设备，阻断非法终端接入。",
  },
  {
    kind: "helmet",
    name: "智能头盔",
    description:
      "通过软密码模块适配智能穿戴终端，结合国密专用算法，实现持续认证与实时管控。",
  },
];
const benefits = [
  { title: "高安全", copy: "可信身份标识，双向认证" },
  { title: "低功耗", copy: "兼顾低功耗与低延时" },
  { title: "普遍适配", copy: "适配多形态物联网终端" },
  { title: "国密专用算法", copy: "以密码算法构建接入安全" },
];
const services = [
  { name: "接入网关", copy: "执行终端准入与管控策略" },
  { name: "认证中心", copy: "协同完成可信身份认证" },
  { name: "密码机", copy: "为认证链路提供密码支撑" },
];
---

<section class="zsac-hero">
  <div class="container-page">
    <nav class="zsac-breadcrumb" aria-label="面包屑导航">
      <a href="/">首页</a>
      <span aria-hidden="true">/</span>
      <a href="/#products">产品中心</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">ZSAC智能准入控制系统</span>
    </nav>
    <div class="zsac-hero-layout">
      <div class="zsac-hero-copy">
        <p class="zsac-kicker">产品中心 / ZSAC</p>
        <h1
          aria-label="ZSAC智能准入控制系统"
          set:html="<span class='zsac-title-line' data-text-reveal>ZSAC智能准入</span><span class='zsac-title-line' data-text-reveal>控制系统</span>"
        />
        <p class="zsac-promise">让每一次接入，都有可信身份。</p>
        <p class="zsac-description">
          以软密码模块连接多形态终端，通过双向认证，实现持续认证与实时管控。
        </p>
        <div class="zsac-actions">
          <ButtonLink
            href="/contact/"
            label="获取产品资料"
            icon="arrow-up-right"
          />
          <a class="zsac-explore" href="#zsac-architecture">
            探索系统架构 <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <div
        class="zsac-hero-network"
        data-zsac-scene
        role="img"
        aria-label="手机、无人机、执法记录仪和智能头盔，通过软密码模块连接 ZSAC 接入安全网关"
      >
        <svg
          class="zsac-hero-traces"
          viewBox="0 0 600 490"
          fill="none"
          aria-hidden="true"
        >
          <g
            data-zsac-traces
            stroke="#89b7f6"
            stroke-width="1.5"
            stroke-dasharray="5 6"
          >
            <path d="M112 112h56q22 0 22 22v44q0 22 22 22h35" />
            <path d="M493 112h-56q-22 0-22 22v44q0 22-22 22h-35" />
            <path d="M112 374h56q22 0 22-22v-44q0-22 22-22h35" />
            <path d="M493 374h-56q-22 0-22-22v-44q0-22-22-22h-35" />
          </g>
          <g fill="white" stroke="#2467d6" stroke-width="2">
            <circle cx="112" cy="112" r="4" />
            <circle cx="493" cy="112" r="4" />
            <circle cx="112" cy="374" r="4" />
            <circle cx="493" cy="374" r="4" />
          </g>
        </svg>
        <div class="zsac-hero-core" data-zsac-layer="core">
          <div class="zsac-render-float" data-zsac-float="core">
            <RenderedAsset
              kind="gateway"
              sizes="(max-width: 520px) 88vw, (max-width: 800px) 450px, 580px"
              priority
            />
          </div>
          <p>
            接入安全网关<span>持续认证 · 实时管控</span>
          </p>
        </div>
        {terminals.map((terminal, index) => (
          <div
            class:list={["zsac-satellite", `zsac-satellite-${index}`]}
            data-zsac-layer={terminal.kind}
          >
            <div
              class:list={["zsac-satellite-art", `zsac-art-${terminal.kind}`]}
            >
              <div class="zsac-render-float" data-zsac-float={terminal.kind}>
                <RenderedAsset
                  kind={
                    terminal.kind as "phone" | "drone" | "camera" | "helmet"
                  }
                  sizes="(max-width: 520px) 42vw, 290px"
                />
              </div>
            </div>
            <span>{terminal.name}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="zsac-benefits">
      {benefits.map((item) => (
        <div>
          <h2>{item.title}</h2>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section
  class="zsac-architecture"
  id="zsac-architecture"
  aria-labelledby="zsac-architecture-title"
  data-zsac-architecture
>
  <div class="container-page">
    <header class="zsac-section-head">
      <p class="zsac-kicker">系统架构</p>
      <h2
        id="zsac-architecture-title"
        set:html="<span class='zsac-heading-phrase' data-text-reveal>从终端到服务，</span><span class='zsac-heading-phrase' data-text-reveal>构建可信接入链路。</span>"
      />
      <p>
        以 ZSAC 接入安全机制为基础，让身份认证、准入控制与集群服务协同工作。
      </p>
    </header>
    <div class="zsac-topology">
      <svg
        class="zsac-topology-lines"
        data-topology-lines
        fill="none"
        aria-hidden="true"
      >
        <defs>
          <marker
            id="zsac-flow-arrow"
            viewBox="0 0 8 8"
            refX="7"
            refY="4"
            markerWidth="7"
            markerHeight="7"
            orient="auto"
            markerUnits="userSpaceOnUse"
          >
            <path
              d="m2 1 4 3-4 3"
              stroke="#2467d6"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </marker>
        </defs>
        {terminals.map((terminal, index) => (
          <path
            class:list={["zsac-route", index === 0 && "is-active"]}
            data-route={terminal.kind}
            marker-end="url(#zsac-flow-arrow)"
          />
        ))}
        {services.map((_, index) => (
          <path
            class="zsac-service-route"
            data-service-route={index}
            marker-end="url(#zsac-flow-arrow)"
          />
        ))}
        {terminals.map((terminal) => (
          <circle
            class="zsac-flow-port"
            data-terminal-port={terminal.kind}
            r="3"
          />
        ))}
        {services.map((_, index) => (
          <circle class="zsac-flow-port" data-service-port={index} r="3" />
        ))}
        <circle class="zsac-flow-junction" data-gateway-in r="4" />
        <circle class="zsac-flow-junction" data-gateway-out r="4" />
      </svg>
      <div class="zsac-terminal-column">
        <h3 class="zsac-column-title">
          <span>01</span>多形态终端
        </h3>
        <p class="zsac-column-note">选择终端，查看接入方式</p>
        <div
          class="zsac-terminal-options"
          role="group"
          aria-label="选择接入终端"
        >
          {terminals.map((terminal, index) => (
            <button
              class="zsac-terminal"
              type="button"
              aria-pressed={index === 0 ? "true" : "false"}
              aria-controls="zsac-terminal-detail"
              data-terminal={terminal.kind}
              data-name={terminal.name}
              data-description={terminal.description}
            >
              <span
                class:list={["zsac-terminal-art", `zsac-art-${terminal.kind}`]}
              >
                <RenderedAsset
                  kind={
                    terminal.kind as "phone" | "drone" | "camera" | "helmet"
                  }
                  sizes="110px"
                  lazy
                />
              </span>
              <span>
                <strong>{terminal.name}</strong>
                <small>软密码模块</small>
              </span>
              <Icon name="chevron-right" size={17} />
            </button>
          ))}
        </div>
      </div>
      <div class="zsac-gateway-column">
        <h3 class="zsac-column-title">
          <span>02</span>可信接入
        </h3>
        <div class="zsac-gateway-diagram">
          <div class="zsac-core-frame">
            <RenderedAsset
              kind="gateway"
              sizes="(max-width: 520px) 90vw, 480px"
              lazy
            />
          </div>
          <p class="zsac-gateway-label">接入安全网关</p>
        </div>
        <div class="zsac-control-pair">
          <span>
            <Icon name="shield" size={22} />
            持续认证
          </span>
          <span>
            <Icon name="settings" size={22} />
            实时管控
          </span>
        </div>
      </div>
      <div class="zsac-service-column">
        <h3 class="zsac-column-title">
          <span>03</span>集群服务
        </h3>
        <p class="zsac-column-note">集群部署 · 负载均衡</p>
        <ul class="zsac-services">
          {services.map((service) => (
            <li>
              <DeviceGlyph kind="server" />
              <div>
                <h4>{service.name}</h4>
                <p>{service.copy}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="zsac-cluster-note">
          <Icon name="chart" size={19} />
          高效、稳定、易扩展
        </p>
      </div>
    </div>
    <div class="zsac-foundation">
      <h3>
        <span>ZSAC</span> 接入安全机制
      </h3>
      <ul>
        {["安全", "合规", "易用", "低成本"].map((word, index) => (
          <li>
            <Icon
              name={(["shield", "file", "layers", "chart"] as const)[index]}
              size={22}
            />
            {word}
          </li>
        ))}
      </ul>
    </div>
    <div
      class="zsac-terminal-detail"
      id="zsac-terminal-detail"
      aria-live="polite"
      aria-atomic="true"
    >
      <span class="zsac-detail-check">
        <Icon name="check" size={21} />
      </span>
      <strong data-terminal-title>手机接入</strong>
      <p data-terminal-description>{terminals[0].description}</p>
    </div>
    <div class="zsac-technical-note">
      <p>
        软密码模块与设备指纹绑定，为终端生成个性化安全算法；通过基于密码算法的双向认证，实现合法终端入网、非法终端阻断。
      </p>
      <a href="/contact/">
        了解部署方案 <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </div>
</section>

<script>
  import { initZsacSceneMotion } from "../../scripts/zsac-scene-motion";
  import { initZsacTopology } from "../../scripts/zsac-topology";
  const cleanupSceneMotion = initZsacSceneMotion();
  const cleanupTopology = initZsacTopology();
  document.addEventListener("astro:before-swap", cleanupTopology, {
    once: true,
  });
  document.addEventListener("astro:before-swap", cleanupSceneMotion, {
    once: true,
  });
  document
    .querySelectorAll<HTMLElement>("[data-zsac-architecture]")
    .forEach((root) => {
      const choices = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-terminal]"),
      );
      choices.forEach((choice) =>
        choice.addEventListener("click", () => {
          choices.forEach((item) =>
            item.setAttribute("aria-pressed", String(item === choice)),
          );
          root
            .querySelectorAll<SVGPathElement>("[data-route]")
            .forEach((route) =>
              route.classList.toggle(
                "is-active",
                route.dataset.route === choice.dataset.terminal,
              ),
            );
          const title = root.querySelector("[data-terminal-title]");
          const activeRoute = root.querySelector(".zsac-route.is-active");
          if (activeRoute) activeRoute.parentElement?.append(activeRoute);
          const description = root.querySelector("[data-terminal-description]");
          if (title) title.textContent = `${choice.dataset.name}接入`;
          if (description)
            description.textContent = choice.dataset.description ?? "";
        }),
      );
    });
</script>

<style>
  .zsac-hero,
  .zsac-architecture {
    --zsac-blue: #2467d6;
    --zsac-ink: #1b2738;
    --zsac-muted: #607086;
    --zsac-edge: #e0eafa;
    --zsac-wash: #f2f7ff;
    color: var(--zsac-ink);
    background: #fff;
  }
  .zsac-hero {
    padding-top: 36px;
    overflow: hidden;
  }
  .zsac-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12px;
    color: var(--zsac-muted);
  }
  .zsac-breadcrumb a:hover {
    color: var(--zsac-blue);
  }
  .zsac-breadcrumb [aria-current] {
    color: var(--zsac-blue);
  }
  .zsac-hero-layout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: 16px;
    min-height: 510px;
    padding-block: 34px;
  }
  .zsac-kicker {
    color: var(--zsac-blue);
    font-size: 14px;
    font-weight: 650;
  }
  .zsac-hero-copy h1 {
    max-width: 580px;
    margin: 21px 0 26px;
    font-size: clamp(38px, 4.1vw, 60px);
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.055em;
    text-wrap: initial;
    word-break: keep-all;
  }
  .zsac-hero-copy h1 :global(.zsac-title-line) {
    display: block;
  }
  .zsac-section-head h2 :global(.zsac-heading-phrase) {
    display: inline-block;
    max-width: 100%;
  }
  .zsac-promise {
    font-size: clamp(18px, 1.65vw, 24px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.6;
  }
  .zsac-description {
    max-width: 420px;
    margin-top: 17px;
    color: var(--zsac-muted);
    font-size: 16px;
    line-height: 1.9;
  }
  .zsac-actions {
    display: flex;
    align-items: center;
    gap: 27px;
    flex-wrap: wrap;
    margin-top: 31px;
  }
  .zsac-explore {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--zsac-blue);
    font-size: 14px;
    font-weight: 600;
  }
  .zsac-explore span {
    font-size: 22px;
    transition: transform 0.3s;
  }
  .zsac-explore:hover span {
    transform: translateY(4px);
  }
  .zsac-hero-network {
    position: relative;
    aspect-ratio: 600/490;
    width: 100%;
    max-width: 660px;
    margin-inline: auto;
  }
  .zsac-hero-traces {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .zsac-hero-core {
    position: absolute;
    left: 7%;
    top: 23%;
    width: 86%;
    text-align: center;
  }
  .zsac-render-float {
    width: 100%;
  }
  .zsac-hero-core p {
    margin-top: -8px;
    font-size: 15px;
    font-weight: 600;
  }
  .zsac-hero-core p span {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    font-weight: 400;
    color: var(--zsac-muted);
  }
  .zsac-satellite {
    position: absolute;
    width: 27%;
    text-align: center;
    font-size: 13px;
    font-weight: 500;
  }
  .zsac-satellite > span {
    display: block;
    position: relative;
    z-index: 1;
    margin-top: 4px;
  }
  .zsac-satellite-0 {
    left: -1%;
    top: -1%;
  }
  .zsac-satellite-1 {
    right: -2%;
    top: -1%;
  }
  .zsac-satellite-2 {
    left: -1%;
    bottom: 0;
  }
  .zsac-satellite-3 {
    right: -2%;
    bottom: 0;
  }
  .zsac-satellite-art {
    position: relative;
    aspect-ratio: 1;
  }
  .zsac-satellite-art > .zsac-render-float {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150%;
    transform: translate(-50%, -50%);
  }
  .zsac-satellite-art.zsac-art-phone > .zsac-render-float {
    width: 190%;
  }
  .zsac-satellite-art.zsac-art-drone > .zsac-render-float {
    width: 125%;
  }
  .zsac-satellite-art.zsac-art-helmet > .zsac-render-float {
    width: 145%;
  }
  .zsac-terminal-art {
    display: block;
    position: relative;
    flex-shrink: 0;
    width: 48px;
    height: 50px;
  }
  .zsac-terminal-art :global(.zsac-render) {
    position: absolute;
    width: 180%;
    left: -40%;
    top: -4%;
    transition: transform 0.35s ease;
  }
  .zsac-terminal:hover .zsac-terminal-art :global(.zsac-render) {
    transform: translateY(-2px);
  }
  .zsac-terminal-art.zsac-art-drone :global(.zsac-render) {
    width: 140%;
    left: -20%;
    top: 7%;
  }
  .zsac-terminal-art.zsac-art-helmet :global(.zsac-render) {
    width: 155%;
    left: -27.5%;
    top: 3%;
  }
  .zsac-benefits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 31px 0 40px;
    border-top: 1px solid var(--zsac-edge);
    gap: 25px;
  }
  .zsac-benefits > div + div {
    padding-left: 30px;
    border-left: 1px solid var(--zsac-edge);
  }
  .zsac-benefits h2 {
    color: var(--zsac-blue);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.5;
  }
  .zsac-benefits p {
    font-size: 13px;
    margin-top: 7px;
    color: var(--zsac-muted);
  }
  .zsac-architecture {
    padding: 95px 0 70px;
    scroll-margin-top: 105px;
  }
  .zsac-section-head h2 {
    word-break: keep-all;
    margin-top: 16px;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 550;
    letter-spacing: -0.05em;
    line-height: 1.4;
  }
  .zsac-section-head > p:last-child {
    margin-top: 18px;
    font-size: 16px;
    color: var(--zsac-muted);
    line-height: 1.85;
  }
  .zsac-topology {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr 1.48fr 1fr;
    gap: 60px;
    margin-top: 52px;
    align-items: start;
  }
  .zsac-topology > div {
    position: relative;
    z-index: 1;
  }
  .zsac-topology-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
  }
  .zsac-topology-lines[data-ready="true"] {
    opacity: 1;
  }
  .zsac-flow-port {
    fill: white;
    stroke: #8db7f0;
    stroke-width: 1.5;
  }
  .zsac-flow-junction {
    fill: #2467d6;
    stroke: white;
    stroke-width: 2;
  }
  .zsac-service-route {
    stroke: #75a8ed;
    stroke-width: 1.5;
  }
  .zsac-column-title {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.5;
  }
  .zsac-column-title > span {
    font-size: 30px;
    letter-spacing: -0.05em;
    color: var(--zsac-blue);
    font-weight: 650;
  }
  .zsac-column-note {
    font-size: 13px;
    color: var(--zsac-muted);
    margin-top: 7px;
    min-height: 22px;
  }
  .zsac-terminal-options {
    display: grid;
    gap: 10px;
    margin-top: 17px;
  }
  .zsac-terminal {
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
    min-height: 76px;
    padding: 10px 13px;
    border: 1px solid var(--zsac-edge);
    border-radius: 7px;
    background: #fff;
    cursor: pointer;
    position: relative;
    transition:
      background 0.25s,
      border-color 0.25s,
      transform 0.25s;
    text-align: left;
  }
  .zsac-terminal:hover {
    background: #f7faff;
    transform: translateX(3px);
    border-color: #adcaf3;
  }
  .zsac-terminal:active {
    transform: translateX(3px) scale(0.98);
  }
  .zsac-terminal[aria-pressed="true"] {
    background: #edf5ff;
    border-color: #bdd7fb;
  }
  .zsac-terminal[aria-pressed="true"]::before {
    position: absolute;
    content: "";
    inset: 10px auto 10px 0;
    width: 3px;
    border-radius: 2px;
    background: var(--zsac-blue);
  }
  .zsac-terminal :global(svg:first-child) {
    width: 44px;
    height: 50px;
    flex-shrink: 0;
    color: var(--zsac-blue);
  }
  .zsac-terminal :global(svg:last-child) {
    margin-left: auto;
    color: var(--zsac-blue);
    flex-shrink: 0;

  </defs>
  <path d="m24 225 176-92 176 92-176 96z" fill="#f0f6ff" stroke="#dceaff" />
  <path d="m53 219 147-77 147 77-147 80z" stroke="#cbdfff" />
  <path d="m76 208 124-65 124 65v28l-124 67-124-67z" fill="#d5e7ff" />

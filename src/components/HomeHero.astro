---
import Icon from "./ui/Icon.astro";
import ButtonLink from "./ui/ButtonLink.astro";
const nodes = [
  {
    label: "设备",
    detail: "可信终端",
    icon: "device" as const,
    position: "device",
  },
  {
    label: "用户",
    detail: "可信身份",
    icon: "users" as const,
    position: "user",
  },
  { label: "应用", detail: "可信访问", icon: "apps" as const, position: "app" },
];
---

<section class="home-hero" aria-label="ZSAC 接入安全">
  <div class="container-page hero-layout">
    <div class="hero-copy">
      <h1 data-text-reveal>
        国密 “接” 万物，
        <br />
        物联 “真” 安全。
      </h1>
      <p class="hero-description" data-reveal>
        以自主创新的国产动态软件密码技术，专注于设备、人员与数据的密码安全服务，为您构建合规、易用、有效的接入安全体系。
      </p>
      <div class="hero-actions" data-reveal>
        <ButtonLink
          href="#products"
          label="探索 ZSAC 产品"
          icon="arrow-up-right"
        />
        <a class="text-link" href="/about/">
          认识联易 <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <div class="hero-principles" data-reveal>
        <span>自主密码技术</span>
        <span>多形态终端适配</span>
        <span>全生命周期防护</span>
      </div>
    </div>
    <div
      class="trust-visual"
      role="img"
      aria-label="ZSAC 接入安全机制示意：设备、用户和应用通过密码模块建立可信连接"
      data-reveal
    >
      <div class="trust-scene">
        <div class="trust-orbit orbit-outer"></div>
        <div class="trust-orbit orbit-inner"></div>
        <svg
          class="trust-paths"
          viewBox="0 0 600 540"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M125 155L300 260L475 155M300 260V435"
            stroke="#a9bfd4"
            stroke-width="1.5"
            stroke-dasharray="5 7"
          />
          <path
            class="signal-path"
            d="M125 155L300 260L475 155M300 260V435"
            stroke="#397aac"
            stroke-width="2.5"
            pathLength="100"
          />
        </svg>
        <div class="trust-platform platform-bottom"></div>
        <div class="trust-platform platform-middle"></div>
        <div class="trust-core">
          <div class="core-inner">
            <span class="core-symbol">
              <Icon name="key" size={36} strokeWidth={1.3} />
            </span>
            <strong>ZSAC</strong>
            <span>接入安全机制</span>
          </div>
        </div>
        {nodes.map((node) => (
          <div class:list={["trust-node", `node-${node.position}`]}>
            <div class="node-inner">
              <Icon name={node.icon} size={27} strokeWidth={1.25} />
              <strong>{node.label}</strong>
              <span>{node.detail}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="trust-caption">
        <span class="status-dot"></span>从身份开始，让信任连接每一端。
        <span class="caption-en">Trust, at every connection.</span>
      </div>
    </div>
  </div>
  <div class="container-page hero-bottom">
    <span>密码为基 · 信任为桥</span>
    <a href="#ecosystem">
      向下探索 <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>

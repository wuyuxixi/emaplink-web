---
import { industries } from "@/data/home";
import HomeDecoration from "./HomeDecoration.astro";
const englishNames: Record<string, string> = {
  金融: "Finance",
  能源: "Energy",
  工业: "Industry",
  电力: "Electric Power",
  交通: "Transportation",
  大型国央企: "State-owned Enterprises",
  政务: "Government Services",
  应急: "Emergency Management",
  环保: "Environmental Protection",
  公安: "Public Security",
};
---

<section class="industry-marquee" aria-label="服务行业" data-industry-marquee data-trust-section>
  <HomeDecoration variant="industry" />
  <div class="marquee-heading">
    <span aria-hidden="true"></span>
    <p class="marquee-title">让信任走进更多行业</p>
    <span aria-hidden="true"></span>
  </div>
  <div class="marquee-window">
    <div class="marquee-track" id="industry-marquee-track">
      {[false, true].map((duplicate) => (
        <ul
          class="marquee-group"
          aria-label={duplicate ? undefined : "服务行业"}
          aria-hidden={duplicate ? "true" : undefined}
        >
          {industries.map((industry) => (
            <li class="marquee-industry">
              <span class="industry-cn">{industry}</span>
              <span class="industry-en" lang="en">
                {englishNames[industry]}
              </span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-industry-marquee]")
    .forEach((marquee) => {
      marquee.dataset.enhanced = "true";
    });
</script>
<style>
  .industry-marquee {
    --marquee-gap: clamp(3rem, 5vw, 5rem);
    margin-top: 70px;
    padding: 32px 0 6px;
    border-radius: 26px;
    background: #fff;
    min-width: 0;
    overflow: hidden;
  }
  .marquee-heading {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-inline: 30px;
  }
  .marquee-heading > span {
    height: 1px;
    background: #e5edf7;
    flex: 1;
    min-width: 0;
  }
  .marquee-title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 42px;
    padding: 9px 20px;
    border: 1px solid #eaf1fb;
    border-radius: 999px;
    background: #f6faff;
    color: #3b587b;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .marquee-window {
    overflow: hidden;
    margin-top: 18px;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 5%,
      #000 95%,
      transparent
    );
  }
  .marquee-track {
    width: 100%;
  }
  .marquee-group {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px var(--marquee-gap);
    padding: 28px 20px;
  }
  .marquee-group[aria-hidden="true"] {
    display: none;
  }
  .marquee-industry {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 9px;
    min-width: 154px;
    text-align: center;
  }
  .industry-cn {
    color: #425c7c;
    font-size: 30px;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .industry-en {
    color: #70829b;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    white-space: nowrap;
  }
  [data-enhanced="true"] .marquee-track {
    display: flex;
    width: max-content;
    animation: industry-marquee-scroll 44s linear infinite;
  }
  [data-enhanced="true"] .marquee-group {
    flex-wrap: nowrap;
    justify-content: flex-start;
    flex-shrink: 0;
    gap: var(--marquee-gap);
    padding: 30px var(--marquee-gap) 30px 0;
  }
  [data-enhanced="true"] .marquee-group[aria-hidden="true"] {
    display: flex;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes industry-marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 767px) {
    .industry-marquee {
      --marquee-gap: 40px;
      margin-top: 42px;
      padding-top: 25px;
      border-radius: 22px;
    }
    .marquee-heading {
      padding-inline: 14px;
      gap: 10px;
    }
    .marquee-title {
      font-size: 12px;
      padding: 8px 13px;
      gap: 6px;
      min-height: 38px;
    }
    .marquee-window {
      margin-top: 15px;
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 7%,
        #000 93%,
        transparent
      );
    }
    .marquee-industry {
      min-width: 142px;
      gap: 8px;
    }
    .industry-cn {
      font-size: 25px;
    }
    .industry-en {
      font-size: 12px;
    }
    .marquee-group {
      gap: 25px 18px;
      padding-inline: 15px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-enhanced="true"] .marquee-track {
      width: 100%;
      animation: none;
      display: block;
    }
    [data-enhanced="true"] .marquee-group {
      justify-content: center;
      flex-wrap: wrap;
      gap: 25px 18px;
      padding: 24px 15px;
    }
    [data-enhanced="true"] .marquee-group[aria-hidden="true"] {
      display: none;
    }
    .marquee-window {
      mask-image: none;
    }
    .marquee-industry {
      min-width: 0;
      flex: 0 0 calc(50% - 9px);
    }
    .industry-en {
      white-space: normal;
      max-width: 100%;
    }
    .industry-cn {
      font-size: clamp(22px, 2.4vw, 30px);
    }
  }
</style>

---
import { site } from "@/data/site";
import ButtonLink from "./ui/ButtonLink.astro";
---

<section class="contact-band">
  <div class="container-page">
    <div class="contact-band-shell" data-reveal>
      <div class="contact-band-core">
        <div>
          <p class="eyebrow">与联易一起，连接信任</p>
          <h2>
            你的安全场景，
            <br />
            值得一次认真沟通。
          </h2>
          <p>从终端、数据到应用，我们一起梳理可行的接入安全路径。</p>
        </div>
        <div class="contact-band-actions">
          <ButtonLink
            href="/contact/"
            label="聊聊你的需求"
            icon="arrow-up-right"
          />
          <a class="contact-phone" href={site.phoneHref}>
            {site.phone}
            <span>7 × 12 小时 · 专家一对一</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{
  "name": "emaplink-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/auto-webp.mjs && astro build && node scripts/generate-aliases.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "node scripts/auto-webp.mjs && node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "auto-webp": "node scripts/auto-webp.mjs",
    "optimize:image": "node scripts/optimize-image.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",

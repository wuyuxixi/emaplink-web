  },
  "dependencies": {
    "@astrojs/sitemap": "latest",
    "astro": "latest",
    "sharp": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "cheerio": "latest",
    "chrome-launcher": "^1.2.2",
    "gray-matter": "latest",
    "lighthouse": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "tailwindcss": "latest",
    "turndown": "latest",
    "turndown-plugin-gfm": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  }
}
